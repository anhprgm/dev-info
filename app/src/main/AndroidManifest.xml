<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional, requested at runtime from the SIM screen only. It is the sole
      way to report the radio technology (5G / LTE / HSPA+); every other field
      on that screen works without it, and denial is a supported state.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Vibration test. Normal permission: no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Microphone level meter only. Audio is read into a short-lived buffer to
      compute an RMS level and is never written to disk, retained or sent
      anywhere. Requested at runtime from the microphone test screen.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Package visibility for the installed-apps list.

      We deliberately do NOT request QUERY_ALL_PACKAGES. Google Play treats the
      installed-app inventory as sensitive personal data; that permission needs
      the Permissions Declaration Form and is only approved where broad
      visibility is the app's core purpose (file managers, browsers, antivirus,
      banking). Declaring the LAUNCHER intent instead exposes every launchable
      app with no permission and no declaration form.

      Trade-off surfaced in the UI: system components without a launcher entry
      are not listed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".DevInfoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevInfo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DevInfo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Grants temporary read access to exported reports so they can be
          shared without any storage permission. Not exported: only URIs this
          app hands out are readable, and only for the receiving app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
